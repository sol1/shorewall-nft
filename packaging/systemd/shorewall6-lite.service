[Unit]
Description=Shorewall6 Lite firewall (nftables, IPv6)
Documentation=man:shorewall-lite(8)
# Start after the network is online, so provider routing and routes-file
# entries can reach nexthops on interfaces the network manager just brought
# up. Do not run beside another firewall manager.
Wants=network-online.target
After=network-online.target
Conflicts=firewalld.service ufw.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/shorewall6-lite start
ExecStop=/usr/sbin/shorewall6-lite stop
ExecReload=/usr/sbin/shorewall6-lite reload
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
