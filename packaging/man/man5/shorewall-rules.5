.\}
.nf
        #ACTION  SOURCE DEST            PROTO   DPORT   SPORT   ORIGDEST
        ACCEPT   net:<2002:ce7c::92b4:1::2,2002:ce7c::92b4:1::22> \e
                        $FW              tcp     22
.fi
.if n \{\
.RE
.\}
.RE
